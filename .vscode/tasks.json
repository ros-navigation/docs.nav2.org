{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install dependencies",
            "type": "shell",
            "command": "uv",
            "args": ["sync"],
            "problemMatcher": []
        },
        {
            "label": "Build Nav2 Docs",
            "type": "shell",
            "command": "uv",
            "args": ["run", "mkdocs", "build"],
            "dependsOn": ["Install dependencies"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Start Nav2 Docs live preview server",
            "type": "shell",
            "command": "uv",
            "args": ["run", "mkdocs", "serve"],
            "dependsOn": ["Install dependencies"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true
        },
    ]
}
